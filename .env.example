# Resend — all outbound email (see src/lib/email.js)
RESEND_API_KEY=re_your_key_here
# Optional: separate key for Sunday weekly summary only (falls back to RESEND_API_KEY)
RESEND_API_KEY_WEEKLY=re_your_weekly_key_here
# Resend webhook signing secret (Dashboard → Webhooks → signing secret)
RESEND_WEBHOOK_SECRET=whsec_your_secret_here
EMAIL_FROM=info@mystarday.se
EMAIL_FROM_NAME=Min Stjärndag
EMAIL_ENABLED=true

# App
APP_URL=https://mystarday.se
JWT_SECRET=change-me-min-32-chars-for-production # pragma: allowlist secret

# Schemalagda push-påminnelser (körs i samma Node-process)
IN_PROCESS_CRONS_ENABLED=true

# Bilduppladdning — Cloudflare R2
UPLOAD_STORAGE=r2
R2_ACCOUNT_ID=82c8772fba7b38fb5c0001b62c82ac8f
R2_BUCKET_NAME=mystarday
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# S3 API — var servern LADDAR UP (inte synlig i webbläsaren)
R2_S3_ENDPOINT=https://82c8772fba7b38fb5c0001b62c82ac8f.r2.cloudflarestorage.com

# Publik URL — var bilder VISAS (r2.dev eller egen domän — INTE cloudflarestorage.com)
# R2 → bucket mystarday → Settings → Public access → Enable r2.dev
R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev

# In-app purchases — Apple/Google via RevenueCat (no web Stripe)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Optional: HMAC signing secret when X-RevenueCat-Webhook-Signature is enabled
REVENUECAT_WEBHOOK_SIGNING_SECRET=
# static | hmac | both — default: both when both secrets are set, else the configured method
REVENUECAT_WEBHOOK_AUTH_MODE=
# Secret API key (sk_…) for server-side GET /subscribers reconciliation — not the public SDK key
REVENUECAT_SECRET_API_KEY=
# Native Sign in with Apple JWT audience (bundle ID). Web Service ID uses APPLE_CLIENT_ID.
APPLE_BUNDLE_ID=se.mystarday.app # pragma: allowlist secret

# Android native app (Google Play)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
FCM_SERVER_KEY=AAAAyour_legacy_fcm_server_key
ANDROID_SHA256_CERT_FINGERPRINT=AA:BB:CC:DD:...
ANDROID_PACKAGE_NAME=se.mystarday.app

# Crash reporting (iOS + Android)
SENTRY_DSN=

# Meta App Events (native Capacitor — used by patch-ios/android-facebook-sdk.mjs)
# App ID is public; Client Token is from Meta App Dashboard → Settings → Advanced.
META_APP_ID=27941105858861495 # pragma: allowlist secret
META_CLIENT_TOKEN=
META_DISPLAY_NAME=

# Pre-deploy database backup gate (VPS production — set real values only on server)
# APP_DB_BACKUP_DIR=/var/backups/app-db
# BACKUP_REQUIRED=1
# APP_DEPLOY_PRODUCTION=1
# PROD_MIN_FAMILY_COUNT=<minimum-families-floor>
# PROD_MIN_DATABASE_BYTES=<minimum-db-size-bytes>
# EXPECTED_DATABASE_IDENTITY_HASH=<sha256-identity-fingerprint>
# BACKUP_MIN_FREE_BYTES=2000000000
# DEPLOY_EMERGENCY_MARKER=/run/backup-gate/incident-marker.json # pragma: allowlist secret
# BACKUP_EMERGENCY_MARKER_FILE=/run/backup-gate/incident-marker.json # pragma: allowlist secret
# PROTECTED_DATABASE_NAME=<production-database-name>
# DISPOSABLE_DB_PREFIX=integrity_restore_
