# Resend — all outbound email (see src/lib/email.js)
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=info@mystarday.se
EMAIL_FROM_NAME=Min Stjärndag
EMAIL_ENABLED=true

# App
APP_URL=https://mystarday.se
JWT_SECRET=change-me-min-32-chars-for-production

# Bilduppladdning — Cloudflare R2 (EU)
UPLOAD_STORAGE=r2
R2_ACCOUNT_ID=82c8772fba7b38fb5c0001b62c82ac8f
R2_JURISDICTION=eu
# Alternativt: klistra in hela URL:en från Cloudflare (bucket-suffix tas bort automatiskt):
# R2_S3_ENDPOINT=https://82c8772fba7b38fb5c0001b62c82ac8f.eu.r2.cloudflarestorage.com/mystarday
R2_BUCKET_NAME=mystarday
R2_ACCESS_KEY_ID=          # R2 → Manage R2 API Tokens → Create API token
R2_SECRET_ACCESS_KEY=
# Publik URL — antingen r2.dev (Public access i bucket) eller egen domän:
R2_PUBLIC_BASE_URL=https://cdn.mystarday.se

# Fallback om R2_* saknas (lokal disk på VPS)
# UPLOAD_LOCAL_DIR=/var/www/mystarday/data/uploads

# In-app purchases — Apple/Google via RevenueCat (no web Stripe)
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
