[Unit]
Description=Weekly historical backup restore test
Documentation=file:__APP_ROOT__/docs/runbooks/BACKUP-RESTORE-RUNBOOK.md
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=__APP_ROOT__
EnvironmentFile=-/etc/deploy-ops/deploy-ops.env
EnvironmentFile=-__APP_ROOT__/.env
ExecStart=/usr/bin/node __APP_ROOT__/scripts/ops/weekly-historical-restore-test.mjs
Nice=10

[Install]
WantedBy=multi-user.target
