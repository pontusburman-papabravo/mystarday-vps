{
  "mcpServers": {
    "resend": {
      "command": "npx",
      "args": [
        "-y",
        "resend-mcp",
        "--sender",
        "info@mystarday.se",
        "--reply-to",
        "info@mystarday.se"
      ],
      "env": {
        "RESEND_API_KEY": "${env:RESEND_API_KEY}",
        "SENDER_EMAIL_ADDRESS": "info@mystarday.se",
        "REPLY_TO_EMAIL_ADDRESSES": "info@mystarday.se"
      }
    }
  }
}
