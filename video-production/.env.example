# fal.ai API key — https://fal.ai/dashboard/keys
# Never commit the real key. Copy to .env locally.
FAL_KEY=

# Pika model endpoint (fal.ai)
PIKA_MODEL=fal-ai/pika/v2.2/image-to-video

# Generation resolution passed to Pika (720p | 1080p)
PIKA_RESOLUTION=1080p

# Cost safeguards — hard limits per run and per calendar day
MAX_GENERATIONS_PER_RUN=12
MAX_GENERATIONS_PER_DAY=24

# Estimated USD per Pika scene (for planning output only; verify on fal.ai pricing)
ESTIMATED_COST_PER_SCENE_USD=0.35

# Polling interval while waiting for fal.ai queue (milliseconds)
POLL_INTERVAL_MS=5000
POLL_TIMEOUT_MS=900000

# ffmpeg binary (override if not on PATH)
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
