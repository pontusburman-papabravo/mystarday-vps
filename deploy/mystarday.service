[Unit]
Description=Min Stjärndag (mystarday-vps)
Documentation=file:///var/www/mystarday/docs/ubuntu-24-vps-deploy.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/mystarday
EnvironmentFile=/var/www/mystarday/.env
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# Graceful shutdown — server.js hanterar SIGTERM (pool + timers)
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
