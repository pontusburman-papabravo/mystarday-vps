{
  "version": 1,
  "checklistSource": "docs/release/STORE_SUBMISSION_CHECKLIST.md",
  "platforms": ["apple", "google"],
  "items": [
    {
      "id": "apple-select-build",
      "platform": "apple",
      "section": "Apple pre-submission",
      "label": "Select build in App Store Connect",
      "checklistAnchor": "Confirm the correct build/version was actually submitted",
      "triggers": { "native": true, "alwaysOnNativeRelease": true }
    },
    {
      "id": "apple-review-account",
      "platform": "apple",
      "section": "Auth / review access",
      "label": "Verify review account works on fresh build",
      "checklistAnchor": "Review account works",
      "triggers": { "paths": ["src/routes/auth/**", "public/login.html", "public/child-login.html", "docs/app-store-demo-konto.md"], "auth": true }
    },
    {
      "id": "apple-screenshots",
      "platform": "apple",
      "section": "Metadata",
      "label": "Confirm screenshots match current app if UI changed",
      "checklistAnchor": "Screenshots match the current app",
      "triggers": { "paths": ["public/**", "assets/**"], "ui": true }
    },
    {
      "id": "apple-privacy-metadata",
      "platform": "apple",
      "section": "Privacy",
      "label": "Confirm App Privacy answers in App Store Connect",
      "checklistAnchor": "App Store \"App Privacy\" answers match code",
      "triggers": { "paths": ["src/lib/**", "public/js/analytics*", "public/js/meta*", "docs/meta-app-events.md"], "privacy": true, "alwaysManual": true }
    },
    {
      "id": "apple-eula-terms",
      "platform": "apple",
      "section": "Legal",
      "label": "Confirm EULA/Terms metadata in App Store Connect",
      "checklistAnchor": "EULA/Terms correct",
      "triggers": { "paths": ["src/lib/legal-routing.js", "public/terms*", "public/privacy*"], "legal": true }
    },
    {
      "id": "apple-iap-metadata",
      "platform": "apple",
      "section": "Subscriptions / IAP",
      "label": "Confirm IAP/subscription products match app",
      "checklistAnchor": "IAP/subscription metadata",
      "triggers": { "paths": ["src/routes/iap.js", "config/iap-product-contract.js", "public/js/iap*", "public/js/paywall*"], "iap": true }
    },
    {
      "id": "apple-restore-purchases",
      "platform": "apple",
      "section": "Subscriptions / IAP",
      "label": "Verify Restore Purchases on device",
      "checklistAnchor": "Restore purchases",
      "triggers": { "paths": ["public/js/iap*", "src/routes/iap.js"], "iap": true }
    },
    {
      "id": "apple-account-deletion",
      "platform": "apple",
      "section": "Apple pre-submission",
      "label": "Verify account deletion end-to-end on review build",
      "checklistAnchor": "Account deletion",
      "triggers": { "paths": ["src/routes/family/account.js", "public/js/settings*"], "auth": true }
    },
    {
      "id": "apple-review-notes",
      "platform": "apple",
      "section": "Metadata",
      "label": "Update Review Notes for gated/flagged features",
      "checklistAnchor": "Review Notes describe gated features",
      "triggers": { "paths": ["docs/app-store-review-notes.md", "src/lib/market-region.js", "config/**"], "featureFlags": true }
    },
    {
      "id": "apple-backend-live",
      "platform": "apple",
      "section": "Apple pre-submission",
      "label": "Confirm backend services live during review window",
      "checklistAnchor": "All backend services are live during review",
      "triggers": { "alwaysOnNativeRelease": true }
    },
    {
      "id": "google-select-track",
      "platform": "google",
      "section": "Google pre-submission",
      "label": "Confirm correct production vs testing track",
      "checklistAnchor": "Production vs testing tracks correct",
      "triggers": { "native": true, "alwaysOnNativeRelease": true }
    },
    {
      "id": "google-data-safety",
      "platform": "google",
      "section": "Privacy",
      "label": "Confirm Play Data Safety answers match code",
      "checklistAnchor": "Data Safety matches actual code",
      "triggers": { "paths": ["src/lib/**", "android/**", "docs/meta-app-events.md"], "privacy": true, "alwaysManual": true }
    },
    {
      "id": "google-review-access",
      "platform": "google",
      "section": "Auth / review access",
      "label": "Verify app access / reviewer credentials in Play Console",
      "checklistAnchor": "App access / reviewer access",
      "triggers": { "paths": ["src/routes/auth/**", "docs/app-store-demo-konto.md"], "auth": true }
    },
    {
      "id": "google-screenshots",
      "platform": "google",
      "section": "Google pre-submission",
      "label": "Confirm store listing screenshots match build",
      "checklistAnchor": "Screenshots/store listing",
      "triggers": { "paths": ["public/**", "assets/play-store/**"], "ui": true }
    },
    {
      "id": "google-target-api",
      "platform": "google",
      "section": "Google pre-submission",
      "label": "Confirm target API level meets Play minimum",
      "checklistAnchor": "Target API level",
      "triggers": { "paths": ["android/**", "assets/play-store/android-sdk.json"], "native": true }
    },
    {
      "id": "google-iap-offers",
      "platform": "google",
      "section": "Subscriptions / IAP",
      "label": "Confirm subscription/base plan state matches READY BUT OFF docs",
      "checklistAnchor": "Subscription/base plan/offer state",
      "triggers": { "paths": ["config/iap-product-contract.js", "docs/PAYMENTS_V1_STATUS.md"], "iap": true }
    },
    {
      "id": "google-permissions",
      "platform": "google",
      "section": "Google pre-submission",
      "label": "Confirm permissions declarations in Play Console",
      "checklistAnchor": "Permissions declarations",
      "triggers": { "paths": ["android/**", "scripts/patch-android-manifest.mjs"], "native": true }
    },
    {
      "id": "google-account-deletion",
      "platform": "google",
      "section": "Google pre-submission",
      "label": "Verify account deletion path + Data Safety declaration",
      "checklistAnchor": "Account deletion requirements",
      "triggers": { "paths": ["src/routes/family/account.js"], "auth": true }
    }
  ],
  "nativePathGlobs": [
    "ios/**",
    "android/**",
    "capacitor.config.*",
    "plugins/**",
    "scripts/*ios*",
    "scripts/*android*",
    "scripts/build-android*.mjs"
  ],
  "unknownPolicy": "MANUAL_REVIEW_REQUIRED"
}
