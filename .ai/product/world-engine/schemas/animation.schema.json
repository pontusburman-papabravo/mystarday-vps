{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stjarndag:world-engine:v1:animation",
  "title": "AnimationClip",
  "type": "object",
  "required": [
    "clip_id",
    "duration_ms"
  ],
  "properties": {
    "clip_id": {
      "type": "string"
    },
    "duration_ms": {
      "type": "integer",
      "maximum": 2000
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "reduced_motion_variant": {
      "type": "string"
    },
    "skippable": {
      "type": "boolean",
      "default": true
    },
    "asset_ref": {
      "type": "string"
    }
  }
}
