node_modules/
.env
.env.*
!.env.example
.DS_Store

# Uploaded images (local disk storage)
data/uploads/*
!data/uploads/.gitkeep
data/downloads/*
!data/downloads/.gitkeep

# Prisma
prisma/*.db
prisma/*.db-journal

# Cursor agent handoff (session-local; template stays in repo)
.cursor/handoff/latest.md
.cursor/handoff/transcript-snapshot.txt
.cursor/handoff/context-state.json

# Scratch / repair / agent-work files
debug/
shell-snapshots/
todos/
fix-*
repair-*
agent-*

# Capacitor Android project (generated locally via npx cap sync / cap open)
android/

# iOS: committed for Xcode Cloud (see ios/.gitignore for build artifacts)

# Android upload keystore (backup locally — required for all future Play updates)
assets/play-store/signing/*.keystore
android/keystore.properties
assets/play-store/signing/*.jks

# Polsia safety (auto-injected)
.claude/
.claude.json*
.tmp/
projects/
*.jsonl
artifacts/

# Video pipeline package (isolated from app build/deploy)
video-*/.env
video-*/node_modules/
video-*/state/
video-*/raw/
video-*/output/
video-*/audio/*.mp3
video-*/audio/*.wav
video-*/audio/*.m4a
video-*/audio/*.aac
!video-*/audio/.gitkeep
!video-*/audio/README.md
