node_modules/
.env
.env.*
!.env.example
.DS_Store

# Uploaded images (local disk storage)
data/uploads/*
!data/uploads/.gitkeep

# Prisma
prisma/*.db
prisma/*.db-journal

# Scratch / repair / agent-work files
debug/
shell-snapshots/
todos/
fix-*
repair-*
agent-*

# Capacitor Android project (generated locally via npx cap sync / cap open)
android/

# iOS: committed for Xcode Cloud (see ios/.gitignore for build artifacts)

# Android upload keystore (backup locally — required for all future Play updates)
assets/play-store/signing/*.keystore
assets/play-store/signing/*.jks

# Polsia safety (auto-injected)
.claude/
.claude.json*
.tmp/
projects/
*.jsonl
