{
  "name": "stjarndag",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "npm run migrate",
    "migrate": "node migrate.js",
    "export:families": "node scripts/export-family-data.js",
    "export:families:sql": "node scripts/export-family-data-sql.js",
    "export:database:sql": "node scripts/export-full-database-sql.js",
    "import:families": "node scripts/import-family-data.js",
    "import:harvest": "node scripts/import-harvest-data.js",
    "harvest:library": "node scripts/harvest-global-library.js",
    "import:library": "node scripts/import-global-library.js",
    "harvest:history": "node scripts/harvest-family-history.js",
    "harvest:streaks": "node scripts/harvest-family-streaks.js",
    "harvest:complete": "node scripts/harvest-complete-all.js",
    "harvest:full": "node scripts/harvest-full-backup.js",
    "sync:features": "node scripts/sync-features-from-prod.js",
    "verify:harvest-history": "node scripts/verify-harvest-history.js",
    "verify:harvest-schedules": "node scripts/verify-harvest-schedules.js",
    "verify:harvest-rewards": "node scripts/verify-harvest-rewards.js",
    "sync:daily-logs": "node scripts/sync-family-daily-logs.js",
    "import:gdpr-history": "node scripts/import-gdpr-history.js",
    "bootstrap:migration": "node scripts/bootstrap-migration-local.js",
    "migration:export": "node scripts/migration-export-cli.js",
    "migration:harvest": "node scripts/migration-harvest-cli.js",
    "migration:harvest:gdpr": "node scripts/migration-harvest-cli.js --gdpr-only --missing-gdpr --resume",
    "test": "node --test test/*.test.js",
    "polsia:gate0": "node scripts/polsia-gate0-audit.mjs",
    "polsia:release-os:check": "npm run lint && npm run test && npm run polsia:gate0",
    "polsia:release-os:generate": "node scripts/generate-polsia-release-os.mjs",
    "lint": "eslint src/ server.js",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "node scripts/prepare-ios-native.mjs && npx cap sync ios && node scripts/patch-ios-podfile.mjs && node scripts/patch-ios-apple-sign-in-presentation.mjs && node scripts/patch-ios-info-plist.mjs && sh -c 'cd ios/App && pod install' && node scripts/patch-ios-entitlements.mjs && node scripts/patch-ios-xcode-sandbox.mjs && node scripts/verify-ios-no-google-pods.mjs",
    "icons:install": "node scripts/install-app-icons.mjs",
    "cap:sync:android": "npm install @codetrix-studio/capacitor-google-auth@^3.4.0-rc.4 --legacy-peer-deps --no-save && npx cap sync android && node scripts/patch-android-manifest.mjs && node scripts/patch-android-strings.mjs",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:dev": "CAP_DEV=true npx cap sync",
    "play-store:assets": "node scripts/generate-play-store-assets.mjs",
    "android:aab": "node scripts/build-android-aab.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.6",
    "express": "^4.18.2",
    "express-rate-limit": "^7.4.1",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.15.0",
    "pg": "^8.11.3",
    "pino": "^8.20.0",
    "stripe": "^17.7.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@capacitor-community/apple-sign-in": "^7.0.0",
    "@capacitor/android": "^7.6.6",
    "@capacitor/app": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.6.6",
    "@capacitor/push-notifications": "^7.0.6",
    "eslint": "^9.0.0",
    "pino-pretty": "^10.3.0",
    "puppeteer": "^25.1.0",
    "sharp": "^0.35.0",
    "typescript": "~5.7.0"
  }
}
