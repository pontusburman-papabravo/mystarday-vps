<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <receiver
            android:name="com.stjarndag.widgetbridge.widget.RoutineWidgetProvider"
            android:exported="true"
            android:label="@string/widget_routine_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.stjarndag.widget.REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/routine_widget_info" />
        </receiver>

        <receiver
            android:name="com.stjarndag.widgetbridge.widget.WidgetCompleteReceiver"
            android:exported="false" />

        <receiver
            android:name="com.stjarndag.widgetbridge.widget.WidgetOpenAppReceiver"
            android:exported="false" />
    </application>
</manifest>
